        "p99": 6.21
      },
      "all_events_stored_exactly_once": true
    },
    {
      "scenario": "chaos",
      "consumers": 1,
      "valid_events": 100000,
      "poison_messages": 100,
      "injected": {
        "producer_send_failures": 5160,
