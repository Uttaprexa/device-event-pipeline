{
  "environment": {
    "store": "sqlite (sqlite 3.45.1, WAL, synchronous=FULL)",
    "queue": "memory",
    "python": "3.12.3",
    "cpus": 1,
    "platform": "Linux-6.18.44-fc-v185-x86_64-with-glibc2.39"
  },
  "runs": [
    {
      "scenario": "throughput",
      "batch_size": 1,
      "events": 50000,
      "seconds": 11.08,
      "events_per_sec": 4512,
      "batch_latency_ms": {
        "p50": 0.16,
        "p95": 0.37,
        "p99": 0.83
      },
      "all_events_stored_exactly_once": true
    },
    {
      "scenario": "throughput",
      "batch_size": 10,
      "events": 50000,
