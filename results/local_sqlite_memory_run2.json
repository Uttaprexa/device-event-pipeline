{
  "environment": {
    "store": "sqlite (sqlite 3.45.1, WAL, synchronous=FULL)",
    "queue": "memory",
    "python": "3.12.3",
    "cpus": 1,
    "platform": "Linux-6.18.44-fc-v185-x86_64-with-glibc2.39"
  },
  "runs": [
